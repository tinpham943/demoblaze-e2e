# Copy to .env to override the defaults. Every key is optional; blank = default.

# Target application (web + REST API)
BASE_URL=https://www.demoblaze.com
API_URL=https://api.demoblaze.com

# Prefix of the users the suite registers (each test signs up its own user: <prefix>_<run id>_<random>)
USERNAME_PREFIX=qa

# Execution
WORKERS=
HEADED=false
# Artifacts kept for failed tests (true by default)
ENABLE_TRACE=
ENABLE_VIDEO=
ENABLE_SCREENSHOT=
